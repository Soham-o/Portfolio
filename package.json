{
  "name": "soham-portfolio",
  "private": true,
  "description": "Static portfolio with automated GitHub synchronization",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node tools/sync/cli.mjs",
    "sync:full": "node tools/sync/cli.mjs --full",
    "render": "node tools/sync/cli.mjs --render-only",
    "check": "node tools/sync/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node tools/lint.mjs"
  },
  "devDependencies": {
    "marked": "18.1.0",
    "sanitize-html": "2.18.0",
    "yaml": "2.9.0"
  }
}
